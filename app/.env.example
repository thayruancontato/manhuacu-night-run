# Copie este arquivo para .env (nao versionado) antes de rodar/buildar o app localmente.

# URL do worker Cloudflare "mcu-nightrun-api" (pasta /worker na raiz do repo).
# Sem essa variavel, todas as chamadas ao worker (WhatsApp, faturas, pagamentos, midias,
# planilha com extrato bancario etc) quebram silenciosamente: o fetch cai numa URL relativa
# que o Firebase Hosting responde com o index.html (SPA fallback) em vez de JSON, e o erro
# no console e algo como "Unexpected token '<', "<!doctype "... is not valid JSON".
VITE_WORKER_URL=https://mcu-nightrun-api.thayrufino2.workers.dev

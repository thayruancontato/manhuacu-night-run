# Copy to .env and fill the real values.
# Keep .env private. It is ignored by git in this workspace.

# Public/local bind
EVOLUTION_PORT=8080

# Evolution API authentication
AUTHENTICATION_API_KEY=change_this_to_a_long_random_key

# Evolution API public URL. Use the Cloudflare hostname after creating the tunnel.
SERVER_URL=https://whatsapp.seu-dominio.com

# Postgres
# Production: use the Neon pooled connection string created for this service.
# Current Neon project created for this stack:
#   project_id=bitter-heart-90280264
#   branch=main
#   database=neondb
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
DATABASE_CONNECTION_CLIENT_NAME=mcu_nightrun_evolution
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true

# Local Postgres fallback. Only used when running the local-db profile.
POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=change_me_local_only

# Redis
REDIS_PASSWORD=change_this_redis_password
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://:change_this_redis_password@redis:6379/6
CACHE_REDIS_PREFIX_KEY=mcu_nightrun
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# QR code and runtime
QRCODE_LIMIT=30
DEL_INSTANCE=false
LOG_LEVEL=ERROR

# Cloudflare Tunnel
# Create a tunnel in Cloudflare Zero Trust and paste its token here.
CLOUDFLARED_TOKEN=ey...
